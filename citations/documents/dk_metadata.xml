<?xml version="1.0"?>
<!--
  Document citation style.
-->
<cite:citation xmlns="http://www.w3.org/1999/xhtml" xmlns:cite="http://eprints.org/ep3/citation" xmlns:epc="http://eprints.org/ep3/control">


  <div class="mdc-layout-grid__inner dk-document-row">
    <div class="mdc-layout-grid__cell mdc-layout-grid__cell--span-1 dkm-leading">
      <mwc-icon>
        <epc:print expr="$item.mime_phrase()"/>
      </mwc-icon>
    </div>
    <div class="mdc-layout-grid__cell mdc-layout-grid__cell--span-9 dkm-centre">
      <epc:print expr="main"/>
      <epc:if test="content"> | <epc:print expr="content"/></epc:if>
      <epc:if test="formatdesc"> | <epc:print expr="formatdesc"/></epc:if>
      <epc:if test="license"> | <epc:phrase ref="licenses_description_{license.as_string()}"/></epc:if>
      <epc:if test="!$item.property('mime_type').one_of( 'application/pdf', 'image/jpeg', 'image/png', 'image/gif', 'image/heic', 'image/webp', 'image/tiff', 'video/mp4', 'video/ogg', 'video/webm' ) or !$item.is_public()">  (Not pictured above)  </epc:if>
      <epc:if test="!$item.is_public()">
        <epc:print expr="security"/> <epc:if test="date_embargo">until <epc:print expr="date_embargo"/></epc:if>
      </epc:if>
    </div>
    <div class="mdc-layout-grid__cell mdc-layout-grid__cell--span-2 dkm-trailing">
      <epc:choose>
        <epc:when test="$item.is_public()">
          <epc:print expr="$item.doc_size().human_filesize()"/>
          <a href="{$item.url()}" download="{$item.property('main')}">
            <mwc-icon>download</mwc-icon>
          </a>
        </epc:when>
        <epc:otherwise>
          <mwc-icon>lock</mwc-icon>
        </epc:otherwise>
      </epc:choose>
    </div>
  </div>

</cite:citation>
